# Notion Integration Token
# https://www.notion.so/my-integrations 에서 생성
NOTION_TOKEN=ntn_your_token_here

# Notion Root Page ID
# 동기화 대상 최상위 Notion 페이지 ID
NOTION_ROOT_PAGE_ID=your_page_id_here

# Obsidian Vault Path
# 동기화할 Obsidian 볼트 절대 경로
OBSIDIAN_VAULT_PATH=/path/to/your/vault

# Sync Database Path (optional)
# 동기화 상태 DB 경로 (기본값: vault/.obsinotion/sync.db)
# SYNC_DB_PATH=

# Image Storage (optional)
# 이미지 외부 저장소 URL (기본값: Notion 직접 업로드)
# IMAGE_STORAGE_URL=

# Log Level (optional)
# debug | info | warn | error (기본값: info)
# LOG_LEVEL=info
