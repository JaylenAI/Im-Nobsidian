{
  "name": "@im-nobsidian/core",
  "version": "0.3.1",
  "description": "Core sync engine for Obsidian ↔ Notion bidirectional synchronization",
  "author": "hanseungheon",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@notionhq/client": "^5.23.1",
    "@tryfabric/martian": "^1.2.0",
    "async-sema": "^3.1.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.0",
    "notion-to-md": "^3.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JaylenAI/Im-Nobsidian",
    "directory": "packages/core"
  },
  "keywords": [
    "obsidian",
    "notion",
    "sync",
    "markdown",
    "bidirectional"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "bugs": {
    "url": "https://github.com/JaylenAI/Im-Nobsidian/issues"
  },
  "homepage": "https://github.com/JaylenAI/Im-Nobsidian#readme"
}
