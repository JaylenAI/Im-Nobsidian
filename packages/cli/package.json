{
  "name": "obsinotion",
  "version": "0.0.1",
  "description": "CLI tool for Obsidian ↔ Notion bidirectional sync",
  "type": "module",
  "bin": {
    "obsinotion": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@obsinotion/core": "workspace:*",
    "commander": "^12.0.0",
    "ora": "^8.0.0",
    "chalk": "^5.3.0",
    "inquirer": "^10.0.0",
    "cli-table3": "^0.6.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "obsidian",
    "notion",
    "sync",
    "cli"
  ],
  "license": "MIT"
}
